# Local development against `npm run db:start`. Get the key from `npx supabase status`.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-publishable-key-from-supabase-status

# Server-only secrets for the public enquiry form (never prefix with NEXT_PUBLIC_).
# Service role key: `npx supabase status`. Used ONLY for the public-enquiry functions.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-from-supabase-status
# Any random string of 32+ characters (openssl rand -hex 32). Keys the IP hash.
ENQUIRY_IP_HASH_SECRET=replace-with-32-plus-random-characters-000000
# Cloudflare Turnstile (optional locally, required in production). Test keys: always-pass
# 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
