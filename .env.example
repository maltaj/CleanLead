# CleanLead environment variables.
# Copy the matching *.example file to .env.local (local dev only). Staging and production
# values live in the hosting provider's environment settings, never in git.

# local | staging | production
APP_ENV=local

# Public site origin, used for auth email redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project API URL and publishable key (the legacy anon key also works).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets are added when a feature needs them (for example SUPABASE_SECRET_KEY for
# the reminder job). Never prefix a secret with NEXT_PUBLIC_.
