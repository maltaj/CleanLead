# Reference for the production environment (Vercel "Production" variables).
APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://<production-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<production-publishable-key>
# Server-only secrets (set in the host's secret store, never committed):
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ENQUIRY_IP_HASH_SECRET=<random 32+ characters>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>
TURNSTILE_SECRET_KEY=<cloudflare-turnstile-secret-key>
